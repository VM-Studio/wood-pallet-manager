@startuml
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FDF6EE
  BorderColor #7c4b2c
  FontColor #3c250f
}
skinparam actor {
  BackgroundColor #E8D5C4
  BorderColor #7c4b2c
  FontColor #3c250f
}
skinparam rectangle {
  BackgroundColor #FAF5F0
  BorderColor #C4895A
  BorderThickness 2
}
skinparam ArrowColor #3c250f

title **Módulo 11 — Devoluciones**\n//WoodPallet Manager//

actor "Propietario" as P
actor "Sistema\n(restaura stock)" as S

rectangle "Gestión de Devoluciones" {

  ' ── Listado y consulta ──────────────────────────────────
  package "Consulta" {
    usecase "Ver listado de\ndevoluciones" as UC01
    usecase "Filtrar por estado" as UC02
    usecase "Ver detalle de\nla devolución" as UC03
    usecase "Ver flujo de estado\nde la devolución" as UC04
    usecase "Ver montos\n(pallets / flete / SENASA / total)" as UC05
  }

  ' ── Registro de solicitud ───────────────────────────────
  package "Registro" {
    usecase "Registrar solicitud\nde devolución" as UC06
    usecase "Seleccionar tipo de caso" as UC07
    usecase "Agregar líneas de\nproductos a devolver" as UC08
    usecase "Definir cantidad\ny precio por producto" as UC09
    usecase "Configurar si devuelve\ncosto de flete" as UC10
    usecase "Configurar si devuelve\ncosto de SENASA" as UC11
    usecase "Calcular monto total\nde la devolución" as UC12
    usecase "Seleccionar método\nde devolución del dinero" as UC13
    usecase "Registrar cuenta destino\npara transferencia" as UC14
  }

  ' ── Flujo de procesamiento ──────────────────────────────
  package "Procesamiento" {
    usecase "Marcar depósito confirmado\nal cliente" as UC15
    usecase "Registrar fecha de\nconfirmación de depósito" as UC16
    usecase "Marcar stock restaurado\nen galpón" as UC17
    usecase "Marcar transferencia\ndevuelta al cliente" as UC18
    usecase "Registrar compensación en\nel siguiente pedido" as UC19
    usecase "Cancelar devolución" as UC20
    usecase "Confirmar cancelación" as UC21
  }

  ' ── Stock (automático) ──────────────────────────────────
  package "Stock" {
    usecase "Restaurar unidades\nen inventario" as UC22
    usecase "Registrar movimiento\nde stock (devolucion)" as UC23
  }

}

' ── Asociaciones ──────────────────────────────────────────
P --> UC01
P --> UC06
P --> UC15
P --> UC17
P --> UC18
P --> UC19
P --> UC20

' ── Sistema ──────────────────────────────────────────────
S --> UC22
S --> UC23

' ── Include / Extend ──────────────────────────────────────
UC01 ..> UC02 : <<extend>>
UC03 ..> UC04 : <<include>>
UC03 ..> UC05 : <<include>>

UC06 ..> UC07 : <<include>>
UC06 ..> UC08 : <<include>>
UC08 ..> UC09 : <<include>>
UC06 ..> UC10 : <<extend>>
UC06 ..> UC11 : <<extend>>
UC06 ..> UC12 : <<include>>
UC06 ..> UC13 : <<extend>>
UC13 ..> UC14 : <<extend>>

UC15 ..> UC16 : <<include>>
UC17 ..> UC22 : <<include>>
UC22 ..> UC23 : <<include>>

UC20 ..> UC21 : <<include>>

' ── Notas ─────────────────────────────────────────────────
note right of UC07
  Tipos de caso:
  pallet_danado | cliente_no_quiere |
  devolucion_parcial | cancelacion_anticipada
end note

note right of UC02
  Estados del flujo:
  pendiente → esperando_confirmacion_deposito
  → confirmada → procesada | cancelada
end note

note bottom of UC17
  Al marcar stock restaurado, el sistema
  incrementa el inventario del producto
  generando un MovimientoStock con
  motivo = "devolucion", tipo = "entrada".
end note

note bottom of UC19
  compensaEnSiguientePedido = true:
  no se devuelve dinero, se aplica como
  descuento en la próxima compra del cliente.
end note

@enduml
