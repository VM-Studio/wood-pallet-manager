@startuml
'──────────────────────────────────────────────────────────────────────────────
'  WoodPallet Manager — DIAGRAMA DE CLASES COMPLETO
'  Tool  : https://www.plantuml.com/plantuml/  o VS Code + extensión PlantUML
'  Junio 2026
'──────────────────────────────────────────────────────────────────────────────

skinparam classBackgroundColor #FDF6EE
skinparam classBorderColor #7c4b2c
skinparam classArrowColor #3c250f
skinparam classFontColor #3c250f
skinparam classHeaderBackgroundColor #E8D5C4
skinparam packageBackgroundColor #FAF5F0
skinparam packageBorderColor #C4895A
skinparam stereotypeFontColor #9B7E6A
skinparam shadowing false

'══════════════════════════════════════════════════════════════════════════════
' ENUMERACIONES
'══════════════════════════════════════════════════════════════════════════════

enum RolUsuario {
  propietario_carlos
  propietario_juancruz
  admin
}

enum TipoVerificacion {
  cambio_password
  cambio_email
  cambio_telefono
  recuperacion_password
}

enum CanalEntrada {
  whatsapp
  formulario_web
  llamada
  recomendacion
  instagram
  email
  otro
}

enum TipoPallet {
  estandar
  reforzado
  liviano
  exportacion
  carton
  a_medida
  personalizado
}

enum CondicionPallet {
  nuevo
  seminuevo
  usado
}

enum TipoProductoProveedor {
  seminuevo
  nuevo_medida
  ambos
}

enum EstadoCotizacion {
  enviada
  en_seguimiento
  aceptada
  rechazada
  perdida
  vencida
}

enum CanalEnvioCotizacion {
  whatsapp
  email
}

enum TipoContacto {
  whatsapp
  llamada
  email
  presencial
}

enum ResultadoSeguimiento {
  sin_respuesta
  interesado
  no_interesado
  cerrado
  reprogramado
}

enum EstadoPedido {
  confirmado
  en_preparacion
  listo_para_envio
  en_transito
  entregado
  entregado_parcial
  cancelado
}

enum TipoEntrega {
  retira_cliente
  envio_woodpallet
}

enum TipoMovimiento {
  entrada
  salida
  ajuste
}

enum MotivoMovimiento {
  venta
  compra
  devolucion
  ajuste_manual
}

enum EstadoCompra {
  pendiente_pago
  pagada
  cancelada
}

enum TipoCompra {
  reventa_inmediata
  stock_propio
}

enum EstadoEntrega {
  pendiente
  en_camino
  entregado
  con_problema
}

enum EstadoConsulta {
  no_aplica
  pendiente_consulta
  consultada
  aceptada
  rechazada
}

enum TipoFactura {
  A
}

enum EstadoCobro {
  pendiente
  cobrada_parcial
  cobrada_total
  vencida
  incobrable
}

enum MedioPago {
  transferencia
  e_check
  efectivo
}

enum MetodoPago {
  transferencia
  e_check
  efectivo
}

enum ModalidadPago {
  adelantado
  contra_entrega
  por_partes
}

enum TipoCasoDevolucion {
  pallet_danado
  cliente_no_quiere
  devolucion_parcial
  cancelacion_anticipada
}

enum EstadoDevolucion {
  pendiente
  esperando_confirmacion_deposito
  confirmada
  procesada
  cancelada
}

enum EstadoRetiro {
  pendiente
  confirmado
  completado
  cancelado
}

enum EstadoRemito {
  pendiente_firma_propietario
  enviado_a_cliente
  firmado_por_cliente
  completado
  cancelado
}

enum EstadoSolicitudLogistica {
  pendiente
  aceptada
  rechazada
}

enum EstadoCotizacionWeb {
  pendiente
  vista
  convertida
  descartada
}

'══════════════════════════════════════════════════════════════════════════════
' CAPA DE DOMINIO — ENTIDADES (Modelos Prisma / Base de Datos)
'══════════════════════════════════════════════════════════════════════════════

package "Dominio: Usuarios y Seguridad" {

  class Usuario {
    +id: Int
    +nombre: String
    +apellido: String
    +email: String <<unique>>
    +passwordHash: String
    +telefono: String?
    +cuit: String?
    +rol: RolUsuario
    +activo: Boolean
    +fechaCreacion: DateTime
    +fotoPerfil: String?
    +firma: String?
  }

  class VerificacionCodigo {
    +id: Int
    +usuarioId: Int?
    +email: String?
    +codigo: String
    +tipo: TipoVerificacion
    +dato: String?
    +canal: String?
    +expiresAt: DateTime
    +usado: Boolean
    +creadoAt: DateTime
  }

  class JwtPayload <<ValueObject>> {
    +userId: Int
    +email: String
    +rol: RolUsuario
  }

}

package "Dominio: Clientes" {

  class Cliente {
    +id: Int
    +razonSocial: String
    +cuit: String?
    +nombreContacto: String?
    +telefonoContacto: String?
    +emailContacto: String?
    +canalEntrada: CanalEntrada?
    +usuarioAsignadoId: Int
    +direccionEntrega: String?
    +localidad: String?
    +esExportador: Boolean
    +observaciones: String?
    +fechaAlta: DateTime
    +activo: Boolean
  }

}

package "Dominio: Catálogo" {

  class Producto {
    +id: Int
    +nombre: String
    +tipo: TipoPallet
    +condicion: CondicionPallet
    +propietarioId: Int
    +dimensionLargo: Int?
    +dimensionAncho: Int?
    +cargaMaximaKg: Int?
    +requiereSenasa: Boolean
    +descripcion: String?
    +activo: Boolean
  }

  class Proveedor {
    +id: Int
    +nombreEmpresa: String
    +nombreContacto: String
    +telefono: String?
    +email: String?
    +tipoProducto: TipoProductoProveedor
    +contactoExclusivoId: Int?
    +distanciaKm: Int?
    +ubicacion: String?
    +observaciones: String?
    +activo: Boolean
  }

  class ProductoProveedor {
    +id: Int
    +proveedorId: Int
    +productoId: Int
    +precioCosto: Decimal
    +fechaActualizacion: DateTime
    +observaciones: String?
  }

  class ListaPrecio {
    +id: Int
    +productoId: Int
    +precioUnitario: Decimal
    +margenPct: Decimal?
    +cantMinima: Int
    +cantMaxima: Int?
