    +vigentDesde: DateTime
    +vigentHasta: DateTime?
    +creadoPorId: Int
    +observaciones: String?
  }

  class HistorialPrecio {
    +id: Int
    +productoId: Int
    +precioAnterior: Decimal
    +precioNuevo: Decimal
    +motivo: String?
    +fechaCambio: DateTime
    +registradoPorId: Int
  }

}

package "Dominio: Inventario y Stock" {

  class Stock {
    +id: Int
    +productoId: Int
    +proveedorId: Int
    +cantidadDisponible: Int
    +cantidadMinima: Int?
    +cantidadDeudora: Int
    +ultimaActualizacion: DateTime
    +observaciones: String?
  }

  class MovimientoStock {
    +id: Int
    +stockId: Int
    +tipoMovimiento: TipoMovimiento
    +cantidad: Int
    +motivo: MotivoMovimiento
    +idReferencia: Int?
    +fecha: DateTime
    +registradoPorId: Int
  }

}

package "Dominio: Cotizaciones" {

  class Cotizacion {
    +id: Int
    +clienteId: Int?
    +usuarioId: Int
    +fechaCotizacion: DateTime
    +fechaVencimiento: DateTime?
    +estado: EstadoCotizacion
    +incluyeFlete: Boolean
    +costoFlete: Decimal?
    +fleteIncluido: Boolean
    +requiereSenasa: Boolean
    +costoSenasa: Decimal?
    +totalSinIva: Decimal?
    +totalConIva: Decimal?
    +canalEnvio: CanalEnvioCotizacion?
    +observaciones: String?
    +esRapida: Boolean
    +nombreProspecto: String?
    +telefonoProspecto: String?
    +emailProspecto: String?
  }

  class DetalleCotizacion {
    +id: Int
    +cotizacionId: Int
    +productoId: Int
    +cantidad: Int
    +precioUnitario: Decimal
    +subtotal: Decimal
    +esAMedida: Boolean
  }

  class EspecificacionMedida {
    +id: Int
    +detalleCotizacionId: Int?
    +detalleVentaId: Int?
    +largoMm: Int?
    +anchoMm: Int?
    +altoMm: Int?
    +cargaMaximaKg: Int?
    +tipoMadera: String?
    +observacionesCliente: String?
    +medidas: Json?
  }

  class SeguimientoCotizacion {
    +id: Int
    +cotizacionId: Int
    +usuarioId: Int
    +fechaContacto: DateTime
    +tipoContacto: TipoContacto
    +resultado: ResultadoSeguimiento
    +observaciones: String?
    +proximoContacto: DateTime?
  }

  class CotizacionWeb {
    +id: Int
    +nombre: String
    +empresa: String?
    +email: String
    +telefono: String?
    +tipoPallet: String?
    +cantidad: Int?
    +fechaNecesidad: DateTime?
    +tipoEntrega: String?
    +localidadEntrega: String?
    +requiereSenasa: Boolean
    +observaciones: String?
    +estado: EstadoCotizacionWeb
    +propietarioAsignadoId: Int?
    +cotizacionId: Int?
    +motivoDescarte: String?
    +ipOrigen: String?
    +creadoEn: DateTime
    +actualizadoEn: DateTime
  }

}

package "Dominio: Ventas y Pedidos" {

  class Venta {
    +id: Int
